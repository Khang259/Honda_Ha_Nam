# multi_rtsp_nvdec_display.py
# Decode nhiều RTSP bằng NVDEC (GPU), pipe rawvideo → OpenCV đọc và hiển thị frames realtime
# Chạy: python multi_rtsp_nvdec_display.py
# Nhấn 'q' trong bất kỳ window nào để dừng tất cả

import subprocess
import threading
import time
import sys
import signal
import os
import cv2
import numpy as np

# Đường dẫn ffmpeg (dùng full_build nếu có thể để chắc chắn NVDEC hoạt động)
FFMPEG_PATH = r"C:\ffmpeg-7.1.1-essentials_build\bin\ffmpeg.exe"

# Danh sách RTSP (thêm bao nhiêu tùy ý, dùng substream nếu có để nhẹ hơn)
RTSP_URLS = [
    "rtsp://admin:Thado12@192.168.1.105:554/Streaming/Channels/102",
    "rtsp://admin:Thado12@192.168.1.115:554/Streaming/Channels/102",
    "rtsp://admin:Thado12@192.168.1.102:554/Streaming/Channels/102",
    # Thêm tiếp...
]

# Giả sử tất cả camera đều 640x480 (thay đổi nếu khác)
FRAME_WIDTH = 640
FRAME_HEIGHT = 480
FRAME_SIZE = FRAME_WIDTH * FRAME_HEIGHT * 3  # bgr24: 3 bytes/pixel

# Option FFmpeg chung
COMMON_FFMPEG_ARGS = [
    "-hwaccel", "nvdec",                    # Decode trên GPU
    "-rtsp_transport", "tcp",
    "-fflags", "+genpts+discardcorrupt",
    "-vsync", "0",
    "-flags", "low_delay",
    "-probesize", "32",
    "-analyzeduration", "0",
    "-f", "rawvideo",                       # Output raw frames
    "-pix_fmt", "bgr24",                    # OpenCV dùng BGR
    "-s", f"{FRAME_WIDTH}x{FRAME_HEIGHT}",  # Resize nếu cần (camera có thể tự scale)
    "pipe:1"                                # Pipe ra stdout
]

# Global flag để dừng tất cả threads
running = True

def signal_handler(sig, frame):
    global running
    print("\nCtrl+C detected. Stopping...")
    running = False
    sys.exit(0)

def display_stream(url, index):
    global running
    cmd = [FFMPEG_PATH] + COMMON_FFMPEG_ARGS[:]
    cmd.extend(["-i", url])

    print(f"[{index:02d}] Starting: {url}")

    try:
        proc = subprocess.Popen(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,  # Giảm log (hoặc chuyển sang file nếu debug)
            bufsize=10**8,              # Buffer lớn để tránh block
            creationflags=subprocess.CREATE_NO_WINDOW
        )

        window_name = f"Cam {index:02d} - {url.split('/')[-1]}"
        cv2.namedWindow(window_name, cv2.WINDOW_NORMAL)

        while running:
            raw_frame = proc.stdout.read(FRAME_SIZE)
            if len(raw_frame) != FRAME_SIZE:
                print(f"[{index:02d}] Frame incomplete or EOF → reconnect?")
                break  # Có thể thêm logic reconnect ở đây

            frame = np.frombuffer(raw_frame, np.uint8).reshape((FRAME_HEIGHT, FRAME_WIDTH, 3))

            # Optional: resize nếu muốn nhẹ hơn
            # frame = cv2.resize(frame, (320, 240))

            cv2.imshow(window_name, frame)

            # Nhấn 'q' để dừng (check mỗi frame)
            if cv2.waitKey(1) & 0xFF == ord('q'):
                running = False
                break

    except Exception as e:
        print(f"[{index:02d}] Error: {e}")
    finally:
        if proc.poll() is None:
            proc.terminate()
            proc.wait()
        cv2.destroyWindow(window_name)
        print(f"[{index:02d}] Stopped")

if __name__ == "__main__":
    signal.signal(signal.SIGINT, signal_handler)

    threads = []
    for i, url in enumerate(RTSP_URLS):
        t = threading.Thread(target=display_stream, args=(url, i), daemon=True)
        t.start()
        threads.append(t)
        time.sleep(0.5)  # Stagger để tránh init cùng lúc

    print(f"\nStarted {len(RTSP_URLS)} streams. Hiển thị realtime.")
    print("Nhấn 'q' trong bất kỳ window để dừng tất cả. Hoặc Ctrl+C.")
    print("Monitor GPU: nvidia-smi -l 1 (xem cột 'dec')")

    try:
        while running:
            time.sleep(1)
    except KeyboardInterrupt:
        running = False

    # Đợi threads dừng
    for t in threads:
        t.join(timeout=5)

    cv2.destroyAllWindows()
    print("All stopped.")